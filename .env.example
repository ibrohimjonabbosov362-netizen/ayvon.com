# Bu fayl NAMUNA. Haqiqiy qiymatlarni faqat .env fayliga yozing.
# .env hech qachon GitHub'ga yuborilmaydi (.gitignore ichida).
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
ADMIN_CHAT_ID=123456789
PORT=3000

# Ixtiyoriy: nginx/reverse-proxy orqasida ishlasa 1 qiling (IP rate limit to‘g‘ri ishlashi uchun)
TRUST_PROXY=0

# Ixtiyoriy: HTTPS orqasida ishlasa 1 qiling (HSTS header qo‘shiladi)
ENABLE_HSTS=0

# Ixtiyoriy: boshqa domenlardan API'ga so‘rovga ruxsat (odatda bo‘sh qoladi)
# ALLOWED_ORIGINS=https://ayvon.uz
