# Bu fayl NAMUNA. Haqiqiy qiymatlarni faqat .env fayliga yozing.
# .env hech qachon GitHub'ga yuborilmaydi (.gitignore ichida).
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
ADMIN_CHAT_ID=123456789
PORT=3000

# Ixtiyoriy: nginx/reverse-proxy orqasida ishlasa 1 qiling (IP rate limit to‘g‘ri ishlashi uchun)
TRUST_PROXY=0

# Ixtiyoriy: HTTPS orqasida ishlasa 1 qiling (HSTS header qo‘shiladi)
ENABLE_HSTS=0

# Ixtiyoriy: boshqa domenlardan API'ga so‘rovga ruxsat (odatda bo‘sh qoladi)
# ALLOWED_ORIGINS=https://ayvon.uz

# ------------------------- Vercel (serverless) uchun -------------------------
# 1 qilinsa polling o‘chadi: update'lar POST /api/telegram ga webhook orqali keladi.
# Vercel'da bu o‘zgaruvchi kerak emas (u yerda webhook ishlatiladi).
# USE_WEBHOOK=1

# Telegram webhook uchun maxfiy sarlavha (A-Z, a-z, 0-9, _ va - belgilari, 1-256 ta).
# Tasodifiy uzun satr yozing va Vercel'da ham xuddi shunday qo‘ying.
# TELEGRAM_WEBHOOK_SECRET=tasodifiy-uzun-maxfiy-satr

# Doimiy saqlash (Vercel'da kerak, chunki disk faqat o‘qish uchun ishlaydi).
# Vercel → Storage → Upstash Redis qo‘shilsa bu qiymatlar avtomatik beriladi.
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxxxxxxxxxx
